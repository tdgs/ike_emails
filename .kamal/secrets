# Kamal reads this file when it deploys. It holds no values: they come from the
# shell, so load them first, from a file outside the repository:
#
#     set -a; source ~/.config/ike-emails/prod.env; set +a
#
# The registry password is the GitHub token of the gh CLI, which needs the
# write:packages scope: gh auth refresh -s write:packages
KAMAL_REGISTRY_PASSWORD=$(gh auth token)

SECRET_KEY_BASE=$SECRET_KEY_BASE
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
# The host is the name of the db accessory on Kamal's Docker network
DATABASE_URL=ecto://ike_emails:${POSTGRES_PASSWORD}@ike-emails-db:5432/ike_emails_prod
BANK_API_TOKEN=$BANK_API_TOKEN

S3_BUCKET=$S3_BUCKET
AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
